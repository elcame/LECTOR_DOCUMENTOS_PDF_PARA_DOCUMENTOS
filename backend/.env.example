# Flask Configuration
FLASK_ENV=production
SECRET_KEY=tu-secret-key-super-seguro-aqui

# Firebase Configuration
# En Cloud Run, usa Secret Manager para las credenciales
# No incluyas el archivo JSON directamente
GOOGLE_APPLICATION_CREDENTIALS=/secrets/firebase-credentials.json

# CORS Configuration
FRONTEND_URL=https://tu-proyecto.web.app

# Session Configuration
SESSION_TYPE=filesystem
PERMANENT_SESSION_LIFETIME=86400

# Upload Configuration
MAX_CONTENT_LENGTH=104857600
UPLOAD_FOLDER=/tmp/uploads

# Google Calendar OAuth (módulo Productividad) — ver backend/docs/GOOGLE_CALENDAR_OAUTH.md
# Opción A: variables sueltas
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Opción B: archivo JSON descargado de Google Console → google-oauth-client.json
# GOOGLE_OAUTH_CREDENTIALS_FILE=app/config/google-oauth-client.json
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5000/api/productividad/google/callback
FRONTEND_URL=http://localhost:5173
